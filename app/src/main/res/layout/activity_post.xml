<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Avatar + Username + Date + Map -->
        <LinearLayout
            android:id="@+id/userInfoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <!-- Avatar -->
            <ImageButton
                android:id="@+id/iconUser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar"
                android:src="@drawable/ic_profile"
                android:tint="@color/green_700"
                android:scaleType="center"
                android:contentDescription="@string/profile"
                android:clickable="false"
                android:focusable="false" />

            <!-- Username + Date -->
            <LinearLayout
                android:id="@+id/userInfoTextLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <LinearLayout
                    android:id="@+id/usernameLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/username"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/neutral_900" />

                    <TextView
                        android:id="@+id/textCreatedAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/created_at"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_500" />
                </LinearLayout>
            </LinearLayout>

            <!-- Distance -->
            <TextView
                android:id="@+id/textDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/km"
                android:textSize="12sp"
                android:textColor="@color/green_500"
                android:layout_marginEnd="8dp" />

            <!-- Map Button -->
            <ImageButton
                android:id="@+id/iconOpenMap"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_map"
                android:tint="@color/neutral_500"
                android:scaleType="centerInside"
                android:contentDescription="@string/open_map" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/neutral_200" />

        <!-- Post Text -->
        <TextView
            android:id="@+id/textPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/this_is_a_post_text"
            android:textSize="15sp"
            android:textColor="@color/neutral_700"
            android:lineSpacingMultiplier="1.3" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/neutral_200" />

        <!-- Actions: Comments + Votes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Comment Group -->
            <ImageButton
                android:id="@+id/iconComment"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_comment"
                android:tint="@color/neutral_500"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/comment" />

            <TextView
                android:id="@+id/textCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comment_count"
                android:textSize="14sp"
                android:textColor="@color/neutral_500"
                android:layout_marginStart="4dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Vote Score -->
            <TextView
                android:id="@+id/totalLikeDislikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_count"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_700"
                android:layout_marginEnd="6dp" />

            <!-- Up Vote -->
            <ImageButton
                android:id="@+id/upVoteIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/arrow_up_bold_outline"
                android:tint="@color/green_700"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/like" />

            <!-- Down Vote -->
            <ImageButton
                android:id="@+id/downVoteIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/arrow_down_bold_outline"
                android:tint="@color/neutral_500"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dislike" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
